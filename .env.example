# Токен бота от @BotFather
BOT_TOKEN=

# Чат, куда падают заявки на покупку (пункт «Важные моменты 1»).
# Создайте группу, добавьте туда бота админом, ID вида -1001234567890.
PURCHASE_CHAT_ID=

# Чат службы заботы. Сообщения людей приходят сюда;
# ответ реплаем в этом чате уходит человеку обратно в бота.
SUPPORT_CHAT_ID=

# ID тех, кому можно загружать записи дней и отзывы, через запятую.
ADMIN_IDS=

# --- необязательное ---
# Куда класть базу (по умолчанию data/marathon.db)
DB_PATH=
# POLL_FALLBACK_HOURS больше не читается: с 17.09.2026 (Павел) следующий
# день приходит только после ответа «Да»/«Нет» — см. bot/config.py.
# Чат для почасовой сводки: сколько новых людей и откуда (по ссылкам
# t.me/бот?start=ig / fb / tg / site). Пусто — сводки нет, есть /stats.
STATS_CHAT_ID=
ENTRY_CHAT_ID=

# Пульт админа — переписки со всеми в одном окне внутри Telegram.
# Адрес сервиса на Railway (кнопка «Generate Domain»), вида
# https://botmarafon-production.up.railway.app. Пусто — пульта нет,
# бот работает как раньше. PORT Railway задаёт сам.
WEBAPP_URL=

# Во сколько по Москве присылать команде мини-отчёт за сутки (AleX 18.09.2026).
# По умолчанию 00:00. Формат ЧЧ:ММ.
DAILY_REPORT_AT=
